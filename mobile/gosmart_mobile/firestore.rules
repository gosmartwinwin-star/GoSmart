rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    match /driverProfiles/{driverProfileId} {
      allow get, list: if isSignedIn()
        && resource.data.authUserId == request.auth.uid;
      allow create, update, delete: if false;
    }

    match /driverApplications/{applicationId} {
      allow get: if isSignedIn()
        && applicationId == request.auth.uid
        && resource.data.authUserId == request.auth.uid;
      allow list: if false;
      allow create, update, delete: if false;

      match /documents/{documentType} {
        allow get: if isSignedIn()
          && applicationId == request.auth.uid
          && get(/databases/$(database)/documents/driverApplications/$(applicationId)).data.authUserId == request.auth.uid;
        allow list: if false;
        allow create, update, delete: if false;
      }
    }

    match /driverAccessPasses/{passId} {
      allow get, list: if isSignedIn()
        && resource.data.driverId is string
        && exists(/databases/$(database)/documents/driverProfiles/$(resource.data.driverId))
        && get(/databases/$(database)/documents/driverProfiles/$(resource.data.driverId)).data.authUserId == request.auth.uid;
      allow create, update, delete: if false;
    }

    match /driverReturnRoutes/{routeId} {
      allow get, list: if isSignedIn()
        && resource.data.driverId is string
        && exists(/databases/$(database)/documents/driverProfiles/$(resource.data.driverId))
        && get(/databases/$(database)/documents/driverProfiles/$(resource.data.driverId)).data.authUserId == request.auth.uid;
      allow create, update, delete: if false;
    }

    match /driverActiveReturnRoutes/{driverId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
