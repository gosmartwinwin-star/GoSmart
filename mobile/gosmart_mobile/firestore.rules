rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    match /driverProfiles/{driverProfileId} {
      allow get, list: if isSignedIn()
        && resource.data.authUserId == request.auth.uid;
      allow create, update, delete: if false;
    }

    match /driverApplications/{applicationId} {
      allow get: if isSignedIn()
        && applicationId == request.auth.uid
        && (
          !exists(/databases/$(database)/documents/driverApplications/$(applicationId))
          || resource.data.authUserId == request.auth.uid
        );
      allow list: if false;
      allow create, update, delete: if false;

      match /documents/{documentType} {
        allow get: if isSignedIn()
          && applicationId == request.auth.uid
          && get(/databases/$(database)/documents/driverApplications/$(applicationId)).data.authUserId == request.auth.uid;
        allow list: if false;
        allow create, update, delete: if false;
      }
    }

    match /driverAccessPasses/{passId} {
      allow get, list: if isSignedIn()
        && resource.data.driverId is string
        && exists(/databases/$(database)/documents/driverProfiles/$(resource.data.driverId))
        && get(/databases/$(database)/documents/driverProfiles/$(resource.data.driverId)).data.authUserId == request.auth.uid;
      allow create, update, delete: if false;
    }

    match /driverReturnRoutes/{routeId} {
      allow get, list: if isSignedIn()
        && resource.data.driverId is string
        && exists(/databases/$(database)/documents/driverProfiles/$(resource.data.driverId))
        && get(/databases/$(database)/documents/driverProfiles/$(resource.data.driverId)).data.authUserId == request.auth.uid;
      allow create, update, delete: if false;
    }

    match /driverActiveReturnRoutes/{driverId} {
      allow read, write: if false;
    }

    match /rides/{rideId} {
      function isRideParticipant(rideData) {
        return isSignedIn()
          && (
            rideData.passengerId == request.auth.uid
            || (
              rideData.driverId is string
              && exists(/databases/$(database)/documents/driverProfiles/$(rideData.driverId))
              && get(/databases/$(database)/documents/driverProfiles/$(rideData.driverId)).data.authUserId == request.auth.uid
            )
          );
      }

      allow get: if isRideParticipant(resource.data);
      allow list, create, update, delete: if false;

      match /events/{eventId} {
        allow get, list: if isSignedIn()
          && exists(/databases/$(database)/documents/rides/$(rideId))
          && isRideParticipant(
            get(/databases/$(database)/documents/rides/$(rideId)).data
          );
        allow create, update, delete: if false;
      }
    }

    match /passengerActiveRides/{passengerId} {
      allow read, write: if false;
    }

    match /driverActiveRides/{driverId} {
      allow read, write: if false;
    }

    match /rideOperations/{operationId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
