{
  "name": "functions",
  "scripts": {
    "lint": "eslint --ext .js,.ts .",
    "build": "tsc",
    "test": "npm run build && node --test lib/*.test.js",
    "test:emulator": "npm run build && node --test lib/ride-lifecycle-emulator.js",
    "admin:claim": "npm run build && node admin-tools/manage-gosmart-admin-claim.mjs",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --project demo-gosmart --only auth,functions,firestore,storage",
    "seed:driver": "npm run build && node lib/local-driver-fixture-cli.js",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test:callable-emulator": "npm run build && firebase emulators:exec --project demo-gosmart --only auth,functions,firestore \"node --test lib/ride-callable-emulator.js\""
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@firebase/app": "0.16.0",
    "@googlemaps/routing": "2.2.1",
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^7.0.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^8.9.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.25.4",
    "firebase-functions-test": "^3.4.1",
    "typescript": "^6.0.0"
  },
  "private": true
}
